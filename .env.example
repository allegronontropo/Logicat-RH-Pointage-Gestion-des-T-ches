# ============================================================
# LOGICAT RH — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Database ---
DB_NAME=logicat_rh
DB_USER=logicat
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://logicat:changeme_strong_password@localhost:5432/logicat_rh

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-for-logicat-rh-2026-production

# --- JWT ---
JWT_EXPIRES_MIN=30

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- Seed ---
# true for demo/local; override to false in production
SEED_DEMO_DATA=true
